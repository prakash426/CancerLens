# CancerLens backend environment template.
# Copy to backend/.env.local (git-ignored) and fill in real values. Never commit real keys.

# ---------------------------------------------------------------------------
# Master live-call switch ($0.00 discipline). While false, every Meta / Baseten
# call is refused before any network I/O. Flip to true only for the single-shot
# "Verify-Once & Commit" milestone smoke test.
# ---------------------------------------------------------------------------
LIVE_LLM_CALLS_ENABLED=false

# ---------------------------------------------------------------------------
# Cancer Info API (Layer 1, single source of truth for medical content)
# ---------------------------------------------------------------------------
CANCER_INFO_API_BASE_URL=https://cancerinfo-api.onrender.com
CANCER_INFO_API_KEY=
CANCER_INFO_API_SEND_X_API_KEY=false
CANCER_INFO_CACHE_TTL_SECONDS=300
CANCER_INFO_API_TIMEOUT_SECONDS=45
# Live-verified: /v1/search is the real search endpoint (2 Nov 2026; Stage 1 assumed
# /v1/evidence/search, which returns HTTP 404) and /v1/facts?ids=a,b is the live
# by-ID endpoint (4 Nov 2026, up to 50 IDs, FactsResponseOut shape). Saved-result
# reads revalidate live; on a by-ID outage they degrade to a labeled unrevalidated
# snapshot (HTTP 200, revalidated=false) and double-checks return a labeled 503.
CANCER_INFO_API_CANCERS_PATH=/v1/cancers
CANCER_INFO_API_SEARCH_PATH=/v1/search
CANCER_INFO_API_FACTS_PATH=/v1/facts

# ---------------------------------------------------------------------------
# Meta Model API ($150 pool; Learn Mode synthesis). Verified call: receipts/2026-10-29-live-meta-text-call.md
# ---------------------------------------------------------------------------
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_BUDGET_CAP_USD=115.00
META_POOL_TOTAL_USD=150.00
META_MAX_OUTPUT_TOKENS=2048
# UNVERIFIED: Meta pricing has not been confirmed. Live Meta calls are refused
# until both prices are set from the official pricing page.
META_PRICE_INPUT_PER_MTOK_USD=
META_PRICE_OUTPUT_PER_MTOK_USD=
# Optional. If empty, cached input tokens are billed at the full input price (conservative).
META_PRICE_CACHED_INPUT_PER_MTOK_USD=

# ---------------------------------------------------------------------------
# Baseten Model API ($100 pool; Claim Verification Layer). Verified: receipts/2026-10-30-baseten-muse-spark-open-eval.md
# ---------------------------------------------------------------------------
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
BASETEN_BUDGET_CAP_USD=65.00
BASETEN_POOL_TOTAL_USD=100.00
# Baseten pricing page, 29 Oct 2026; owner confirmed 1 Nov 2026 that -1026 uses the same rates.
BASETEN_PRICE_INPUT_PER_MTOK_USD=1.25
BASETEN_PRICE_CACHED_INPUT_PER_MTOK_USD=0.15
BASETEN_PRICE_OUTPUT_PER_MTOK_USD=4.25

LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Local operational SQLite (no medical corpus tables)
# ---------------------------------------------------------------------------
OPERATIONAL_DB_PATH=./cancerlens_app.db
SAVED_RESULT_TTL_DAYS=30
# Off until DHRUV's Stage 2 PII sanitizer replaces the Stage 1 baseline.
CLAIM_MEMORY_CAPTURE_ENABLED=false

EVALUATE_MAX_HOPS=3
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","http://127.0.0.1:8080"]

# Stage 2 launch gate for POST /api/v1/extract/url (SSRF-guarded public fetch).
# Keep false until the owner explicitly enables public-URL extraction.
URL_EXTRACTION_ENABLED=false
